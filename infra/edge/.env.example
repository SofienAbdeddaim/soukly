# Settings of the edge Caddy (DEP-02). Copy to /opt/soukly/edge/.env (mode 600) on the VM.
# Placeholders only: never commit the real file.

# Contact address registered with Let's Encrypt (expiry and incident notices).
ACME_EMAIL=admin@example.com

# Dev host. Provisional free address while the real domain is not ready:
#   dev.<public-ip-with-dashes>.sslip.io, for example dev.203-0-113-10.sslip.io
# Recommended once the DNS of the real domain is ready: dev.soukly.tn (see infra/vm/README.md).
DEV_HOST=dev.203-0-113-10.sslip.io

# Prod host. Empty until the domain points to the VM: no prod site is declared.
# Then: PROD_HOST=soukly.tn (www.soukly.tn redirects to it).
PROD_HOST=

# Garage bucket served on photos.<DEV_HOST> (same value as S3_BUCKET of the dev stack).
DEV_S3_BUCKET=soukly-listings
