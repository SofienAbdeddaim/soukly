# Settings of the prod backup (DEP-02). Copy to /opt/soukly/backups/backup.env (mode 600,
# owner deploy) on the VM. Placeholders only: never commit the real file.

# S3-compatible object storage, for example Hetzner Object Storage:
#   https://<location>.your-objectstorage.com (location fsn1, nbg1 or hel1)
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_REGION=fsn1
# Private bucket, separate from the photos.
BACKUP_S3_BUCKET=soukly-backups
# S3 credentials that can reach the soukly-backups bucket (ideally not the application's).
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
# Days of backups kept, today included.
BACKUP_RETENTION_DAYS=7
# Compose project whose postgres container is saved.
BACKUP_COMPOSE_PROJECT=soukly-prod
