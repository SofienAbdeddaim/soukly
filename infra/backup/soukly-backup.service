# Nightly backup of the prod databases (DEP-02). Installed by infra/vm/setup.sh.
# Status and logs: systemctl status soukly-backup / journalctl -u soukly-backup
[Unit]
Description=Soukly prod database backup to object storage
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/sbin/soukly-pg-backup
TimeoutStartSec=1h
