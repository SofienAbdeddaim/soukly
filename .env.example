# Copy this file to .env and adjust the values for your machine.
# Never commit .env: it is ignored by git. Values below are placeholders only.

# Backend service ports (defaults used by application.yml)
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
LISTING_SERVICE_PORT=8082
SOCIAL_PUBLISHER_PORT=8083

# Public URL of the site (domain is never hard-coded in the code)
PUBLIC_BASE_URL=http://localhost:4200
